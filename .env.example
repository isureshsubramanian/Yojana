# Copy to .env, or let `make env` generate one. Never commit .env.
# SQL Server sa password for the development container (docker-compose.yml) and the host's connection string.
YOJANA_SQL_PASSWORD=
# Password given to every seeded development user (make seed).
YOJANA_SEED_PASSWORD=
# Deployment-specific HMAC key for pseudonymising unknown e-mail addresses in the security audit.
YOJANA_SECURITY_AUDIT_HMAC_KEY=
# Storage benchmark target (P1-T21, tools/Yojana.Bench): a SQL Server reachable from this machine; the tool creates database yojana_bench there.
YOJANA_BENCH_SQL_HOST=
YOJANA_BENCH_SQL_PASSWORD=
