{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.invalid/cx02/extension/v1.0/reservation-entry.schema.json",
  "title": "Reservation entry page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "itemNumber", "quantity", "sourceDocumentType", "sourceDocumentNumber", "sourceLineNumber", "serialNumber", "lotNumber", "packageNumber", "lastModifiedDateTime", "@odata.etag"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "itemNumber": { "type": "string" },
    "locationCode": { "type": ["string", "null"] },
    "quantity": { "type": "number" },
    "quantityBase": { "type": ["number", "null"] },
    "reservationStatus": { "type": ["string", "null"] },
    "sourceDocumentType": { "type": "string", "enum": ["salesInvoice", "salesShipment", "salesCreditMemo", "purchaseReceipt", "transferShipment", "transferReceipt", "returnReceipt", "itemJournal", "other"] },
    "sourceDocumentNumber": { "type": "string", "maxLength": 20 },
    "sourceLineNumber": { "type": "integer" },
    "sourceDocumentId": { "type": ["string", "null"], "format": "uuid" },
    "serialNumber": { "type": "string" },
    "lotNumber": { "type": "string" },
    "packageNumber": { "type": "string" },
    "positive": { "type": ["boolean", "null"] },
    "lastModifiedDateTime": { "type": "string", "format": "date-time" },
    "@odata.etag": { "type": "string" }
  }
}
