{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.invalid/cx02/extension/v1.0/post-tracked-document-request.schema.json",
  "title": "Post tracked document action request",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "tracking"],
  "properties": {
    "documentType": { "type": "string", "enum": ["salesShipment", "salesCreditMemo", "purchaseReceipt", "transferShipment", "transferReceipt", "returnReceipt", "serviceOrder"] },
    "documentId": { "type": "string", "format": "uuid" },
    "logicalReference": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object", "additionalProperties": true },
    "tracking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineId", "quantity", "serialNumber", "lotNumber", "packageNumber"],
        "properties": {
          "lineId": { "type": "string", "format": "uuid" },
          "quantity": { "type": "number" },
          "serialNumber": { "type": "string" },
          "lotNumber": { "type": "string" },
          "packageNumber": { "type": "string" }
        }
      }
    }
  }
}
