{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.invalid/cx02/extension/v1.0/item-entry-relation.schema.json",
  "title": "Item entry relation page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceDocumentType", "sourceDocumentNumber", "sourceLineNumber", "itemLedgerEntryNumber", "lastModifiedDateTime", "@odata.etag"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sourceDocumentType": { "type": "string", "enum": ["salesInvoice", "salesShipment", "salesCreditMemo", "purchaseReceipt", "transferShipment", "transferReceipt", "returnReceipt", "itemJournal", "other"] },
    "sourceDocumentNumber": { "type": "string", "maxLength": 20 },
    "sourceLineNumber": { "type": "integer" },
    "sourceDocumentId": { "type": ["string", "null"], "format": "uuid" },
    "itemLedgerEntryNumber": { "type": "integer" },
    "lastModifiedDateTime": { "type": "string", "format": "date-time" },
    "@odata.etag": { "type": "string" }
  }
}
