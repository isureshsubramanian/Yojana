{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.invalid/cx02/extension/v1.0/item-entry-relation.schema.json",
  "title": "Item entry relation page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceType", "sourceId", "sourceLineNumber", "itemLedgerEntryNumber", "lastModifiedDateTime", "@odata.etag"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sourceType": { "type": "string" },
    "sourceSubtype": { "type": ["string", "null"] },
    "sourceId": { "type": "string", "format": "uuid" },
    "sourceLineNumber": { "type": "integer" },
    "itemLedgerEntryNumber": { "type": "integer" },
    "lastModifiedDateTime": { "type": "string", "format": "date-time" },
    "@odata.etag": { "type": "string" }
  }
}
