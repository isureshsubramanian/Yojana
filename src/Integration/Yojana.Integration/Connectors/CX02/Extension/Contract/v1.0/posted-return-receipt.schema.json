{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.invalid/cx02/extension/v1.0/posted-return-receipt.schema.json",
  "title": "Posted return receipt page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "postingDate", "customerNumber", "lastModifiedDateTime", "@odata.etag"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "number": { "type": "string" },
    "postingDate": { "type": "string", "format": "date" },
    "customerNumber": { "type": "string" },
    "externalDocumentNumber": { "type": ["string", "null"] },
    "lastModifiedDateTime": { "type": "string", "format": "date-time" },
    "@odata.etag": { "type": "string" }
  }
}
