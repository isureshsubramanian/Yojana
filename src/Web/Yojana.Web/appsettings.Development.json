{
  "Logging": { "LogLevel": {
      "Default": "Information",
      "Quartz": "Warning",
      "Wolverine": "Information"
    }
  },
  "Platform": {
    "ConnectionString": "Server=localhost,1433;Database=yojana;User Id=sa;Encrypt=True;TrustServerCertificate=True",
    "MaxPoolSize": 200,
    "MigrateOnStartup": true,
    "AutoBuildMessageStorage": true,
    "Mail": {
      "Transport": "pickup",
      "FromAddress": "no-reply@dev.yojana.local",
      "LinkBaseUrl": "http://localhost:5080",
      "PickupDirectory": "/tmp/yojana-mail"
    }
  },
  "Serialisation": {
    "ImportFiles": {
      "DatabaseConnectionString": "Server=localhost,1433;Database=yojana_import_files;User Id=sa;Encrypt=True;TrustServerCertificate=True",
      "FileRoot": "/tmp/yojana-import-files",
      "ArchiveStores": [
        { "Name": "folder-archive", "Kind": "folder", "Path": "/tmp/yojana-import-files-archive" },
        { "Name": "database-archive", "Kind": "database", "ConnectionString": "Server=localhost,1433;Database=yojana_files_archive;User Id=sa;Encrypt=True;TrustServerCertificate=True" }
      ]
    }
  }
}
