<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>yojana-web</UserSecretsId>
    <!--
      The SDK's static web assets pipeline (Razor/Blazor asset discovery) is off: the client is plain copied
      content under wwwroot in the output folder, and Program.cs serves exactly that in every environment.
      With it on, Development would look for a project-level wwwroot that deliberately does not exist.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Composition root: the only project allowed to reference every module implementation. -->
    <ProjectReference Include="../../Platform/Yojana.Platform/Yojana.Platform.csproj" />
    <ProjectReference Include="../../Serialisation/Yojana.Serialisation/Yojana.Serialisation.csproj" />
    <ProjectReference Include="../../Integration/Yojana.Integration/Yojana.Integration.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by `make notices`; shipped inside the artefact and served at /notices. -->
    <Content Include="Notices/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Declared coupling (MOD-02 to MOD-01 host): the web client's build output (web/dist, produced by `make web`
      through web/build.mjs) becomes this host's wwwroot in the build and publish output, and Program.cs points
      the web root at that copy. The three places that know the path are web/build.mjs, tools/gates/budgets.json
      and this item; change them together. When web/dist is absent the host still builds and serves the API only.
    -->
    <Content Include="../../../web/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
