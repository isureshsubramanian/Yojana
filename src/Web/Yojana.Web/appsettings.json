{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Platform": {
    "ConnectionString": "",
    "Files": { "DatabaseConnectionString": "" },
    "MaxPoolSize": 200,
    "MigrateOnStartup": false,
    "AutoBuildMessageStorage": false,
    "Mail": {
      "Transport": "none",
      "FromAddress": "",
      "FromName": "Yojana",
      "LinkBaseUrl": "",
      "MaxAttempts": 8,
      "LogRetentionDays": 90,
      "Smtp": { "Host": "", "Port": 587, "Security": "starttls", "UserName": "", "TimeoutSeconds": 30 },
      "Graph": { "TenantId": "", "SenderMailbox": "", "Credential": "managed_identity", "ClientId": "", "TimeoutSeconds": 30 }
    },
    "Passkeys": {
      "RelyingPartyId": "",
      "RelyingPartyName": "Yojana",
      "Origins": []
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    },
    "SignIn": {
      "AccountFailureThreshold": 5,
      "AccountWindowMinutes": 15,
      "InitialLockoutMinutes": 1,
      "MaximumLockoutMinutes": 30,
      "AddressFailureThreshold": 50,
      "AddressWindowMinutes": 15,
      "RequestLimitPerMinute": 120,
      "SecurityEventRetentionDays": 400,
      "MaximumPasswordLength": 128
    }
  },
  "Serialisation": {
    "InteractiveReadCommandTimeoutSeconds": 10,
    "ImportFiles": {
      "DatabaseConnectionString": "",
      "FileRoot": "",
      "ArchiveStores": []
    },
    "Certificates": {
      "MaximumSynchronousUnits": 2000,
      "Renderer": "html",
      "PdfWorkerBaseUrl": "",
      "PdfRequestTimeoutSeconds": 60
    }
  }
}
