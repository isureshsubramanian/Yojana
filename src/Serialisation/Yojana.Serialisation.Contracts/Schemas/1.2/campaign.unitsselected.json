{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.2/campaign.unitsselected.json",
  "title": "Campaign.UnitsSelected",
  "type": "object",
  "required": ["header", "campaign_id", "campaign_code", "coverage_source", "reserve_tag", "reason_code", "parts_pct", "labour_pct", "travel_pct", "selection_command_id", "batch_number", "batch_count", "matched_count", "total_selected_count", "units"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["schema", "version", "event_id", "event_time", "recorded_time", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "type": "string" },
        "version": { "type": "string" },
        "event_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" },
        "recorded_time": { "type": "string", "format": "date-time" },
        "legal_entity_id": { "type": "string", "format": "uuid" },
        "actor_ref": { "type": "string" },
        "document": { "type": ["object", "null"] }
      }
    },
    "campaign_id": { "type": "string", "format": "uuid" },
    "campaign_code": { "type": "string" },
    "coverage_source": { "enum": ["recall", "goodwill"] },
    "reserve_tag": { "type": "string" },
    "reason_code": { "enum": ["safety", "reliability", "firmware", "regulatory", "goodwill"] },
    "reason_note": { "type": ["string", "null"], "maxLength": 500 },
    "runs_until": { "type": ["string", "null"], "format": "date" },
    "parts_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "labour_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "travel_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "selection_command_id": { "type": "string", "format": "uuid" },
    "batch_number": { "type": "integer", "minimum": 1 },
    "batch_count": { "type": "integer", "minimum": 1 },
    "matched_count": { "type": "integer", "minimum": 0 },
    "total_selected_count": { "type": "integer", "minimum": 0 },
    "units": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["unit_id"],
        "properties": {
          "unit_id": { "type": "string", "format": "uuid" },
          "owner_party_ref": { "type": ["string", "null"], "format": "uuid" },
          "owner_party_type": { "type": ["string", "null"] },
          "custodian_party_ref": { "type": ["string", "null"], "format": "uuid" },
          "custodian_party_type": { "type": ["string", "null"] }
        }
      }
    }
  }
}
