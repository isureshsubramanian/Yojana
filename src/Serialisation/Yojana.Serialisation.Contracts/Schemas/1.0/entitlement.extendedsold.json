          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "id"
          ]
