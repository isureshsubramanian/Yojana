{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/entitlement.extendedsold.json",
  "title": "Entitlement.ExtendedSold",
  "type": "object",
  "required": [
