        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_time": {
          "type": "string",
          "format": "date-time"
        },
        "seq": {
          "type": "integer"
        },
        "legal_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_ref": {
