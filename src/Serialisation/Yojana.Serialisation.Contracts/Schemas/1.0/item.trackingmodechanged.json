{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/item.trackingmodechanged.json",
  "title": "Item.TrackingModeChanged",
  "type": "object",
  "required": ["header", "correction", "item_id", "previous_tracking_mode", "tracking_mode", "effective_at", "reversed", "stock_coverage"],
  "properties": {
    "header": { "$ref": "#/$defs/header" },
    "correction": { "$ref": "#/$defs/correction" },
    "item_id": { "type": "string", "format": "uuid" },
    "previous_tracking_mode": { "type": "string" },
    "tracking_mode": { "type": "string" },
    "effective_at": { "type": "string", "format": "date-time" },
    "reversed": { "type": "boolean" },
    "stock_coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } }
  },
  "$defs": {
    "header": {
      "type": "object", "required": ["schema", "version", "event_id", "event_time", "recorded_time", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "type": "string" }, "version": { "type": "string" }, "event_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" }, "recorded_time": { "type": "string", "format": "date-time" },
        "legal_entity_id": { "type": "string", "format": "uuid" }, "actor_ref": { "type": "string" },
        "document": { "anyOf": [{ "$ref": "#/$defs/document" }, { "type": "null" }] }
      }
    },
    "correction": {
      "type": "object", "required": ["correction_id", "reason_code", "initiated_via", "approver_refs"],
      "properties": {
        "correction_id": { "type": "string", "format": "uuid" }, "reason_code": { "type": "string" },
        "initiated_via": { "type": "string" }, "corrects_correction_id": { "type": ["string", "null"], "format": "uuid" },
        "approver_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coverage": {
      "type": "object", "required": ["location_kind", "open_quantity", "commissioned_quantity", "exempt_quantity", "source_document"],
      "properties": {
        "location_id": { "type": ["string", "null"], "format": "uuid" }, "location_kind": { "type": "string" },
        "open_quantity": { "type": "integer" }, "commissioned_quantity": { "type": "integer" }, "exempt_quantity": { "type": "integer" },
        "exempt_reason": { "type": ["string", "null"] }, "source_document": { "$ref": "#/$defs/document" }
      }
    },
    "document": {
      "type": "object", "required": ["type", "id"],
      "properties": { "type": { "type": "string" }, "id": { "type": "string", "format": "uuid" }, "line": { "type": ["integer", "null"] } }
    }
  }
}
