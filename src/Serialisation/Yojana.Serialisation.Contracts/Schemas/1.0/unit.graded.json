{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/unit.graded.json",
  "title": "Unit.Graded",
  "type": "object",
  "required": ["header", "grade", "valuation_rule"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["schema", "version", "event_id", "unit_id", "event_time", "recorded_time", "seq", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "type": "string" },
        "version": { "type": "string" },
        "event_id": { "type": "string", "format": "uuid" },
        "unit_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" },
        "recorded_time": { "type": "string", "format": "date-time" },
        "seq": { "type": "integer" },
        "legal_entity_id": { "type": "string", "format": "uuid" },
        "actor_ref": { "type": "string" },
        "document": {
          "type": ["object", "null"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string", "format": "uuid" },
            "line": { "type": ["integer", "null"] }
          },
          "required": ["type", "id"]
        }
      }
    },
    "grade": { "type": "string", "enum": ["new", "open_box", "refurbished_a", "refurbished_b", "refurbished_c", "used", "remanufactured", "defective", "scrap"] },
    "f_code": { "type": ["string", "null"], "pattern": "^F[1-6]$" },
    "c_code": { "type": ["string", "null"], "pattern": "^C[1-9]$" },
    "valuation_rule": { "type": "string" }
  }
}
