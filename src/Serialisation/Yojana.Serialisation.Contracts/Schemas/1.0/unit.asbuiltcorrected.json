{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/unit.asbuiltcorrected.json",
  "title": "Unit.AsBuiltCorrected",
  "type": "object",
  "required": [
    "header",
    "correction",
    "change",
    "effective_at"
  ],
  "properties": {
    "header": {
      "$ref": "#/$defs/header"
    },
    "correction": {
      "$ref": "#/$defs/correction"
    },
    "change": {
      "type": "string",
      "enum": [
        "add",
        "remove",
        "replace"
      ]
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed": {
      "$ref": "#/$defs/assembly_link"
    },
    "installed": {
      "$ref": "#/$defs/assembly_link"
    }
  },
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "event_id",
        "unit_id",
        "event_time",
        "recorded_time",
        "seq",
        "legal_entity_id",
        "actor_ref"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_time": {
          "type": "string",
          "format": "date-time"
        },
        "seq": {
          "type": "integer"
        },
        "legal_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_ref": {
          "type": "string"
        },
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/document_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "correction": {
      "type": "object",
      "required": [
        "correction_id",
        "reason_code",
        "initiated_via",
        "approver_refs"
      ],
      "properties": {
        "correction_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason_code": {
          "type": "string"
        },
        "initiated_via": {
          "type": "string",
          "enum": [
            "workbench",
            "api",
            "migration",
            "system"
          ]
        },
        "corrects_correction_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "approver_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "document_ref": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "assembly_link": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "assembly_link_id",
        "relation"
      ],
      "properties": {
        "assembly_link_id": {
          "type": "string",
          "format": "uuid"
        },
        "child_unit_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "child_item_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "child_lot_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "relation": {
          "type": "string"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
