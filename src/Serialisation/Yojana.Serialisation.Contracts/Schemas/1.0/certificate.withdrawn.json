{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/certificate.withdrawn.json",
  "title": "Certificate.Withdrawn",
  "type": "object",
  "required": ["header", "certificate_id", "document_kind", "certificate_version", "reason", "triggering_correction_event_id", "reversed_sale_event_id", "withdrawn_at"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["schema", "version", "event_id", "unit_id", "event_time", "recorded_time", "seq", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "const": "Certificate.Withdrawn" },
        "version": { "const": "1.0" },
        "event_id": { "type": "string", "format": "uuid" },
        "unit_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" },
        "recorded_time": { "type": "string", "format": "date-time" },
        "seq": { "type": "integer" },
        "legal_entity_id": { "type": "string", "format": "uuid" },
        "actor_ref": { "type": "string" },
        "document": { "type": ["object", "null"] }
      }
    },
    "certificate_id": { "type": "string", "format": "uuid" },
    "document_kind": { "const": "release_record" },
    "certificate_version": { "type": "integer", "minimum": 1 },
    "reason": { "const": "correction" },
    "triggering_correction_event_id": { "type": "string", "format": "uuid" },
    "reversed_sale_event_id": { "type": "string", "format": "uuid" },
    "withdrawn_at": { "type": "string", "format": "date-time" }
  }
}
