{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/unit.identifiersassigned.json",
  "title": "Unit.IdentifiersAssigned",
  "type": "object",
  "required": [
    "header",
    "correction",
    "production_order",
    "assignments",
    "remaining_count",
    "awaiting_vendor_serial_unit_ids"
  ],
  "properties": {
    "header": {
      "$ref": "#/$defs/header"
    },
    "correction": {
      "$ref": "#/$defs/correction"
    },
    "production_order": {
      "$ref": "#/$defs/document_ref"
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "remaining_count": {
      "type": "integer",
      "minimum": 0
    },
    "awaiting_vendor_serial_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "event_id",
        "event_time",
        "recorded_time",
        "legal_entity_id",
        "actor_ref"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_time": {
          "type": "string",
          "format": "date-time"
        },
        "legal_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_ref": {
          "type": "string"
        },
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/document_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "correction": {
      "type": "object",
      "required": [
        "correction_id",
        "reason_code",
        "initiated_via",
        "approver_refs"
      ],
      "properties": {
        "correction_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason_code": {
          "type": "string"
        },
        "initiated_via": {
          "type": "string",
          "enum": [
            "workbench",
            "api",
            "migration",
            "system"
          ]
        },
        "corrects_correction_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "approver_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "document_ref": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "identifier": {
      "type": "object",
      "required": [
        "type",
        "scheme",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "issuer_party_ref": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "unit_id",
        "identifier_id",
        "identifier"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "identifier_id": {
          "type": "string",
          "format": "uuid"
        },
        "identifier": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
