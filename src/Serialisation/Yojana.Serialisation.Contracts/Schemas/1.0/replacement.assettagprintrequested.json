{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.0/replacement.assettagprintrequested.json",
  "title": "Replacement.AssetTagPrintRequested",
  "type": "object",
  "required": ["header", "warranty_replacement_id", "replacement_link_id", "identifier_id", "asset_tag"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["schema", "version", "event_id", "unit_id", "event_time", "recorded_time", "seq", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "type": "string" },
        "version": { "type": "string" },
        "event_id": { "type": "string", "format": "uuid" },
        "unit_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" },
        "recorded_time": { "type": "string", "format": "date-time" },
        "seq": { "type": "integer" },
        "legal_entity_id": { "type": "string", "format": "uuid" },
        "actor_ref": { "type": "string" },
        "document": {
          "type": ["object", "null"],
          "required": ["type", "id"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string", "format": "uuid" },
            "line": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "warranty_replacement_id": { "type": "string", "format": "uuid" },
    "replacement_link_id": { "type": "string", "format": "uuid" },
    "identifier_id": { "type": "string", "format": "uuid" },
    "asset_tag": { "type": "string" }
  }
}
