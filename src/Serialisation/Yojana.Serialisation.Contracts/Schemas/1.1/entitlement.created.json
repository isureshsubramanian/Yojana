{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.1/entitlement.created.json",
  "title": "Entitlement.Created",
  "type": "object",
  "required": ["header", "entitlement_id", "item_id", "coverage_family", "entitlement_type", "obligor_entity_id", "policy_version_id", "policy_code", "policy_version", "status", "assurance_or_service", "accrual_suppressed", "provenance"],
  "properties": {
    "header": { "type": "object" },
    "entitlement_id": { "type": "string", "format": "uuid" },
    "item_id": { "type": "string", "format": "uuid" },
    "coverage_family": { "type": "string" },
    "entitlement_type": { "type": "string" },
    "obligor_entity_id": { "type": "string", "format": "uuid" },
    "owner_party_ref": { "type": ["string", "null"], "format": "uuid" },
    "policy_version_id": { "type": "string", "format": "uuid" },
    "policy_code": { "type": "string" },
    "policy_version": { "type": "integer" },
    "start_date": { "type": ["string", "null"], "format": "date" },
    "end_date": { "type": ["string", "null"], "format": "date" },
    "status": { "type": "string" },
    "accrual_cohort_id": { "type": ["string", "null"], "format": "uuid" },
    "assurance_or_service": { "type": "string" },
    "accrual_suppressed": { "type": "boolean" },
    "provenance": { "type": "string" },
    "source_document": { "type": ["object", "null"] },
    "disclosure": {
      "type": ["object", "null"],
      "properties": {
        "term_months": { "type": "integer" },
        "floor_applied": { "type": "boolean" },
        "floor_months": { "type": ["integer", "null"] },
        "floor_source": { "type": ["string", "null"], "enum": ["policy", "jurisdiction", null] },
        "refurbisher_party_ref": { "type": ["string", "null"], "format": "uuid" },
        "statement_kind": { "type": "string", "enum": ["no_oem_warranty", "oem_refurbished", "seller_refurbished"] },
        "matched_row": { "type": "object" }
      },
      "required": ["term_months", "floor_applied", "statement_kind", "matched_row"]
    }
  }
}
