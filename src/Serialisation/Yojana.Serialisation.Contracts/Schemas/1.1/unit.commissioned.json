{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yojana.local/serialisation/schemas/1.1/unit.commissioned.json",
  "title": "Unit.Commissioned",
  "type": "object",
  "required": ["header", "item_id", "origin", "lifecycle_status", "identifiers", "commissioned_late"],
  "properties": {
    "header": { "$ref": "#/$defs/header" },
    "item_id": { "type": "string", "format": "uuid" },
    "origin": { "type": "string" },
    "lifecycle_status": { "type": "string" },
    "identifiers": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
    "lot_id": { "type": ["string", "null"], "format": "uuid" },
    "location_id": { "type": ["string", "null"], "format": "uuid" },
    "location_kind": { "type": ["string", "null"] },
    "commissioned_late": { "type": "boolean" }
  },
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema", "version", "event_id", "unit_id", "event_time", "recorded_time", "seq", "legal_entity_id", "actor_ref"],
      "properties": {
        "schema": { "type": "string" }, "version": { "type": "string" },
        "event_id": { "type": "string", "format": "uuid" }, "unit_id": { "type": "string", "format": "uuid" },
        "event_time": { "type": "string", "format": "date-time" }, "recorded_time": { "type": "string", "format": "date-time" },
        "seq": { "type": "integer" }, "legal_entity_id": { "type": "string", "format": "uuid" },
        "actor_ref": { "type": "string" }, "document": { "anyOf": [{ "$ref": "#/$defs/document" }, { "type": "null" }] }
      }
    },
    "document": {
      "type": "object", "required": ["type", "id"],
      "properties": { "type": { "type": "string" }, "id": { "type": "string", "format": "uuid" }, "line": { "type": ["integer", "null"] } }
    },
    "identifier": {
      "type": "object", "required": ["type", "scheme", "value"],
      "properties": { "type": { "type": "string" }, "scheme": { "type": "string" }, "value": { "type": "string" }, "issuer_party_ref": { "type": ["string", "null"], "format": "uuid" } }
    }
  }
}
